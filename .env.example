# =============================================================================
# MODELO DE VARIÁVEIS DE AMBIENTE
# =============================================================================
#
# Este arquivo é um MODELO. Ele fica no repositório de propósito, com todos os
# valores vazios, só para você saber quais chaves existem.
#
# COMO USAR
#   1. Faça uma cópia deste arquivo com o nome .env.local
#   2. Preencha só as linhas do que você for usar
#   3. Nunca envie o .env.local para o GitHub (o .gitignore já bloqueia)
#
# O app funciona 100% SEM nenhuma destas chaves. A diferença é que agora o
# código dos dois primeiros blocos JÁ ESTÁ ESCRITO: preencher as linhas e
# reiniciar o servidor liga a funcionalidade, sem programar nada. O roteiro
# completo está em PROXIMOS-PASSOS.md.
#
# REGRA DE OURO: chave é senha. Se você colar uma chave de verdade num arquivo
# que vai para o GitHub, qualquer pessoa pode usar (e você paga a conta).
# Vazou? Apague a chave no painel do serviço e gere outra. Não tem como
# "desvazar".
# =============================================================================


# -----------------------------------------------------------------------------
# LOGIN COM GOOGLE
# -----------------------------------------------------------------------------
# Para quê: deixar a pessoa entrar no app com a conta Google dela, de verdade.
#
# JÁ ESTÁ PRONTO. O fluxo inteiro está escrito em src/lib/google.ts e nas rotas
# de src/app/api/auth. Sem as chaves abaixo, o botão "Continuar com Google"
# abre o tutorial de configuração; com elas, ele faz login de verdade. Você não
# escreve uma linha de código: preenche, reinicia o servidor e pronto.
#
# Onde conseguir: https://console.cloud.google.com/apis/credentials
#   Crie um projeto → Credenciais → Criar credenciais → ID do cliente OAuth →
#   Aplicativo da Web. Em "URIs de redirecionamento autorizados" coloque
#   http://localhost:3000/api/auth/callback/google (e depois o endereço da
#   Vercel, quando publicar).
#
# O CLIENT_ID pode aparecer no navegador. O CLIENT_SECRET NUNCA.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# O segredo que assina a sua sessão. Este não vem do Google: é seu, e pode ser
# qualquer texto embaralhado de 32 caracteres ou mais. No terminal:
#
#   openssl rand -base64 32
#
# Sem ele o login com Google não liga, mesmo com as duas chaves acima
# preenchidas. Trocar este valor derruba todo mundo que estava logado, o que é
# exatamente o que você quer fazer se um dia ele vazar.
AUTH_SECRET=


# -----------------------------------------------------------------------------
# BANCO DE DADOS
# -----------------------------------------------------------------------------
# Para quê: guardar clientes, pedidos e compromissos num servidor, em vez de no
# navegador. É o que faz os dados sobreviverem a trocar de computador.
#
# JÁ ESTÁ PRONTO. A camada está escrita em src/lib/banco.ts e o app cria a
# tabela sozinho na primeira vez que fala com o banco (o desenho está em
# banco/schema.sql). Sem a linha abaixo, tudo continua no navegador; com ela, o
# mesmo app passa a gravar no Postgres. Nenhuma tela muda.
#
# Onde conseguir: https://neon.com — crie um projeto Postgres (tem plano
# gratuito) e copie a "Connection string" do painel.
#
# Formato: postgresql://usuario:senha@servidor/banco?sslmode=require
# Repare que a senha vai dentro da própria URL. Trate a linha inteira como senha.
DATABASE_URL=


# -----------------------------------------------------------------------------
# ENVIO DE E-MAIL
# -----------------------------------------------------------------------------
# Para quê: mandar e-mail de verdade — confirmação de compromisso, lembrete de
# prazo, boas-vindas.
#
# Onde conseguir: https://resend.com/api-keys — crie a conta, verifique um
# domínio (ou use o domínio de teste deles) e gere uma API key.
#
# A chave começa com "re_".
RESEND_API_KEY=


# -----------------------------------------------------------------------------
# WHATSAPP
# -----------------------------------------------------------------------------
# Para quê: avisar você (ou o cliente) no WhatsApp quando algo acontece no app.
#
# Onde conseguir: https://developers.facebook.com/docs/whatsapp/cloud-api
#   Crie um app no Meta for Developers → adicione o produto WhatsApp → pegue o
#   token de acesso. O token de teste expira em 24 horas; o permanente sai
#   depois da verificação do negócio.
#
# Caminho mais fácil para começar: a Twilio tem uma sandbox de WhatsApp que
# funciona em minutos — https://www.twilio.com/docs/whatsapp
WHATSAPP_TOKEN=


# -----------------------------------------------------------------------------
# N8N (AUTOMAÇÕES)
# -----------------------------------------------------------------------------
# Para quê: o endereço do "gatilho" que o app chama quando algo acontece. O n8n
# recebe esse chamado e dispara a automação que você desenhou na tela dele.
#
# Onde conseguir: suba o n8n com a pasta n8n/ deste projeto (leia n8n/README.md),
# crie um fluxo começando com o nó "Webhook" e copie a URL que ele mostra.
#
# Rodando na sua máquina, costuma ser algo como:
#   http://localhost:5678/webhook/nome-do-seu-fluxo
N8N_WEBHOOK_URL=
